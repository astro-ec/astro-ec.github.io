      #72eaff 95%
    );

    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;

    filter: drop-shadow(0 0 24px rgb(153 126 255 / 42%));
  }


.hero-eyebrow {
  color: var(--color-muted);
  /* Keep the other existing properties */
}

.hero-eyebrow span {
  color: var(--color-cyan);
  margin-inline: 0.6rem;
}

.title-line {
  display: block;
  color: var(--color-ink);
}

.title-glow {
  margin-top: 0.18em;

  background: linear-gradient(
    105deg,
