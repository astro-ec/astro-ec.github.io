  font-family: var(--font-heading);
  font-size: 0.65rem;
  letter-spacing: 0.18em;
}

  @keyframes float {
    0%, 100% {
      transform: translateY(0);
    }

    50% {
      transform: translateY(-11px);
    }
  }

  @media (max-width: 600px) {
    .cosmos-hero {
      min-height: 620px;
      padding: 6rem 1.25rem;
    }

    .hero-eyebrow {
      font-size: 0.6rem;
      letter-spacing: 0.12em;
    }

    .planet-violet {
      --size: 48px;
      top: 11%;
      left: 8%;
    }

    .planet-cyan {
      --size: 36px;
      top: 17%;
      right: 8%;
    }

    .planet-solar {
      --size: 40px;
      left: 12%;
      bottom: 13%;
    }

    .planet-pink {
      right: 13%;
      bottom: 13%;
    }

    .orbit-one {
      width: 130%;
    }

    .orbit-two {
      width: 150%;
    }

    .orbit-three {
      width: 100%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cosmos-scene,
    .planet {
      transition: none;
    }

    .planet-core {
      animation: none;
    }

    .planet:hover {
      transform: none;
    }
  }
</style>
