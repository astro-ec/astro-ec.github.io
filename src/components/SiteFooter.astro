---
import { navigationLinks } from '../data/navigation';

const year = new Date().getFullYear();
---

<footer class="site-footer">

  <div class="footer-content">

    <div class="footer-identity">
      <a href="/" class="footer-brand" aria-label="OEAA — Inicio">
        OEAA<span class="brand-dot">.</span>
      </a>

      <p class="organisation">
        Olimpiadas Ecuatorianas de<br />
        Astronomía y Astrofísica
      </p>

      <p class="footer-message">
        Mirar más lejos empieza con hacer preguntas.
      </p>

      <div class="brand-line" aria-hidden="true"></div>
    </div>

    <nav class="footer-navigation" aria-label="Navegación del pie de página">
      <span class="footer-heading">Explora</span>

      {navigationLinks.map((link) => (
        <a href={link.href}>{link.label}</a>
      ))}
    </nav>

  </div>

  <div class="footer-bottom">
    <span>© {year} OEAA</span>
    <span>Desde Ecuador hacia el universo. ✦</span>
  </div>

</footer>

<style>
  .site-footer {
    position: relative;
    isolation: isolate;
    overflow: hidden;

    width: min(calc(100% - 2rem), var(--page-width));
    margin: clamp(4rem, 8vw, 7rem) auto 1rem;
    padding: clamp(1.5rem, 4vw, 3rem);

    background: var(--glass-background);
    border: 1px solid var(--glass-border);
    border-radius: var(--radius-lg);

    backdrop-filter: blur(24px) saturate(160%);
    -webkit-backdrop-filter: blur(24px) saturate(160%);

    box-shadow: 0 8px 32px var(--color-shadow);
  }

  .site-footer::before {
    content: '';
    position: absolute;
    z-index: -1;

    width: 360px;
    height: 360px;

    top: -180px;
    right: -120px;

    border: 1px solid var(--color-cyan);
    border-radius: 50%;

    transform: rotate(-25deg) scaleY(0.55);
    opacity: 0.35;

    pointer-events: none;
  }

  .footer-content {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: 3rem;
  }

  .footer-brand {
    font-family: var(--font-heading);
    font-size: 2.2rem;
    font-weight: 700;
    letter-spacing: -0.06em;
    line-height: 1;

    color: var(--color-ink);
    text-decoration: none;
  }

  .brand-dot {
    color: var(--color-brand);
  }

  .organisation {
    margin: 0.8rem 0 0;
    font-size: 0.85rem;
    font-weight: 500;
    line-height: 1.5;
    color: var(--color-muted);
  }

  .footer-message {
    margin: 1.8rem 0 1rem;
    font-family: var(--font-heading);
    font-size: clamp(1.15rem, 2vw, 1.5rem);
    font-weight: 500;
    letter-spacing: -0.025em;
    color: var(--color-ink);
  }

  .brand-line {
    width: 90px;
    height: 3px;
    border-radius: 3px;

    background: linear-gradient(
      90deg,
      var(--color-brand),
      var(--color-cyan),
      var(--color-solar)
    );
  }

  .footer-navigation {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.65rem;
  }

  .footer-heading {
    margin-bottom: 0.4rem;

    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 0.95rem;
    color: var(--color-ink);
  }

  .footer-navigation a {
    color: var(--color-muted);
    font-size: 0.85rem;
    text-decoration: none;

    transition:
      color var(--transition),
      transform var(--transition);
  }

  .footer-navigation a:hover {
    color: var(--color-brand);
    transform: translateX(3px);
  }

  .footer-bottom {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.5rem;

    margin-top: 3rem;
    padding-top: 1.25rem;

    border-top: 1px solid var(--color-border);

    font-size: 0.75rem;
    color: var(--color-muted);
  }

  @media (max-width: 600px) {
    .footer-content {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }

    .site-footer::before {
      right: -240px;
    }
  }
</style>
