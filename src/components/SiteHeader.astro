---
import ThemeToggle from './ThemeToggle.astro';
import { navigationLinks, participateHref } from '../data/navigation';
---

<header class="site-header">
  <div class="container header-inner">


<a class="brand" href="/" aria-label="OEAA — Inicio">
  <span class="brand-mark" aria-hidden="true">
    <img
      class="logo-light"
      src="/images/logo-light.svg"
      alt=""
      width="54"
      height="54"
    />

    <img
      class="logo-dark"
      src="/images/logo-dark.svg"
      alt=""
      width="54"
      height="54"
    />
  </span>

  <span class="brand-text">
    <span class="brand-title">OEAA</span>
    <span class="brand-subtitle">
      Astronomía y Astrofísica · Ecuador
    </span>
  </span>
</a>


    <nav class="desktop-nav" aria-label="Navegación principal">
      {navigationLinks.map((link) => (
        <a href={link.href}>{link.label}</a>
      ))}
    </nav>

    <div class="header-actions">
  <ThemeToggle />

    <a href="/#participa" class="button button-primary desktop-cta">
      ✦ Participa
    </a>

    <details class="mobile-nav">
      <summary class="menu-toggle" aria-label="Abrir o cerrar el menú de navegación">
        Menú
        <span class="menu-icon" aria-hidden="true">
          <span></span>
          <span></span>
          <span></span>
        </span>
      </summary>

      <nav class="mobile-panel" aria-label="Navegación móvil">
        {navigationLinks.map((link) => (
          <a href={link.href}>{link.label}</a>
        ))}

        <a href="/#participa" class="button button-primary">
          ✦ Participa
        </a>
      </nav>
    </details>

  </div>

  </div>
</header>

<style>


.site-header {
  position: sticky;
  top: 1rem;
  z-index: 100;

  width: min(1200px, calc(100% - 2rem));
  margin: 1rem auto 0;

  background: var(--glass-background);
  border: 1px solid var(--glass-border);
  border-radius: 20px;

  backdrop-filter: blur(24px) saturate(160%);
  -webkit-backdrop-filter: blur(24px) saturate(160%);

  box-shadow: 0 8px 32px var(--color-shadow);
}
.header-actions {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  flex-shrink: 0;
}

  .header-inner {
    min-height: var(--header-height);
    display: flex;
    align-items: center;
    gap: 2rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.8rem;
    text-decoration: none;
    flex-shrink: 0;
  }


.brand-mark {
  position: relative;
  display: block;
  width: 54px;
  height: 54px;
  flex-shrink: 0;
}

.brand-mark img {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: contain;

  transition:
    opacity var(--transition),
    transform 400ms ease;
}

.logo-light { opacity: 1; }
.logo-dark  { opacity: 0; }

:global(html[data-theme='dark']) .logo-light {
  opacity: 0;
}

:global(html[data-theme='dark']) .logo-dark {
  opacity: 1;
}

@media (prefers-color-scheme: dark) {
  :global(html:not([data-theme])) .logo-light {
    opacity: 0;
  }

  :global(html:not([data-theme])) .logo-dark {
    opacity: 1;
  }
}

.brand:hover .brand-mark img {
  transform: rotate(-8deg) scale(1.06);
}

  .brand-text {
    display: flex;
    flex-direction: column;
  }

  .brand-title {
    font-family: var(--font-heading);
    font-size: 1.45rem;
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.04em;
    color: var(--color-brand);
  }

  .brand-subtitle {
    font-size: 0.65rem;
    font-weight: 500;
    color: var(--color-muted);
    letter-spacing: 0.01em;
  }

  .desktop-nav {
    display: flex;
    align-items: center;
    gap: clamp(1rem, 2vw, 2rem);
    margin-left: auto;
  }

  .desktop-nav a {
    font-size: 0.88rem;
    font-weight: 500;
    text-decoration: none;
    white-space: nowrap;
    transition: color var(--transition);
  }

  .desktop-nav a:hover {
    color: var(--color-brand);
  }

  .desktop-cta {
    flex-shrink: 0;
    white-space: nowrap;
  }

  .mobile-nav {
  display: none;
  position: relative;
}

  .menu-toggle {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    padding: 0.65rem 0.9rem;

    border-radius: var(--radius-sm);
    background: var(--glass-background);
    color: var(--color-brand);

    font-size: 0.85rem;
    font-weight: 600;
    cursor: pointer;
    list-style: none;
  }

  .menu-toggle::-webkit-details-marker {
    display: none;
  }

  .menu-icon {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .menu-icon span {
    width: 18px;
    height: 2px;
    background: currentColor;
    border-radius: 2px;
    transition: transform var(--transition), opacity var(--transition);
  }

  .mobile-nav[open] .menu-icon span:first-child {
    transform: translateY(6px) rotate(45deg);
  }

  .mobile-nav[open] .menu-icon span:nth-child(2) {
    opacity: 0;
  }

  .mobile-nav[open] .menu-icon span:last-child {
    transform: translateY(-6px) rotate(-45deg);
  }

  .mobile-panel {
  position: absolute;
  top: calc(100% + 0.75rem);
  right: 0;
  z-index: 1;

  display: flex;
  flex-direction: column;

  width: min(320px, calc(100vw - 3rem));
  padding: 0.8rem;

  background: var(--glass-background);
  border: 1px solid var(--glass-border);
  border-radius: var(--radius-md);

  backdrop-filter: blur(22px) saturate(160%);
  -webkit-backdrop-filter: blur(22px) saturate(160%);

  box-shadow: 0 16px 40px var(--color-shadow);
}

  .mobile-panel > a:not(.button) {
    padding: 0.75rem 0.9rem;
    border-radius: var(--radius-sm);
    text-decoration: none;
    font-size: 0.95rem;
  }

  .mobile-panel > a:not(.button):hover {
    background: var(--color-brand-soft);
    color: var(--color-brand);
  }

  .mobile-panel .button {
    margin-top: 0.5rem;
  }

 /* Tablet and mobile */

@media (max-width: 1100px) {
  .desktop-nav,
  .desktop-cta {
    display: none;
  }

  .mobile-nav {
    display: block;
  }

  .header-actions {
    margin-left: auto;
  }
}

/* Small phones */

@media (max-width: 480px) {
  .header-inner {
    gap: 0.65rem;
  }

  .brand-mark {
    width: 46px;
    height: 46px;
  }

  .brand-text {
    display: none;
  }

  .menu-label {
    display: none;
  }

  .menu-toggle {
    padding: 0.65rem;
  }
}
</style>
