---
import Layout from '~/layouts/PageLayout.astro';
import Image from '~/components/common/Image.astro';
import Hero from '~/components/widgets/Hero.astro';
import Note from '~/components/widgets/Note.astro';
import Features from '~/components/widgets/Features.astro';
import Features2 from '~/components/widgets/Features2.astro';
import Steps from '~/components/widgets/Steps.astro';
import Content from '~/components/widgets/Content.astro';
import BlogLatestPosts from '~/components/widgets/BlogLatestPosts.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import Stats from '~/components/widgets/Stats.astro'
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: 'OEAA - Astronomía EC',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <!-- Hero Widget ******************* -->
  <Hero
  actions={[
    {
      variant: 'primary',
      text: '¡Inscríbete!',
      href: 'https://bit.ly/oeaa2026',
      target: '_blank',
    },
    { text: 'Conoce más', href: '#olimpiada-nacional' },
  ]}
  image={{ src: '~/assets/images/mw.png', alt: 'Galaxy' }}
  >
  <Fragment slot="title">
    <div class="flex flex-col space-y-1">
      <span class="block sm:inline dark:text-white"> Olimpiadas Ecuatorianas</span>
      <span class="text-accent dark:text-[#5D78B5] highlight"> de Astronomía y Astrofísica</span>
    </div>
  </Fragment>

  <Fragment slot="subtitle">
    <span class="hidden sm:inline">
      Aprende sobre el Universo y participa en competencias internacionales</span
    >
  </Fragment>
  </Hero>


  <!-- Note Widget ******************* -->

  <Note />

  <!-- Features Widget *************** -->

  <Features
    id="features"
    tagline="La Olimpiada Nacional"
    title="Empieza tu viaje desde el Ecuador"
    subtitle="¡Aprende sobre astronomía y astrofísica de la mano de expertos!"
    items={[
      {
        title: 'El mejor material para aprender astrofísica',
        description:
          'Desde los fundamentos hasta temas avanzados, contamos con material académico para preparación, incluidos examenes nacionales e internacionales',
        icon: 'tabler:book',
      },
      {
        title: 'Clases online en vivo',
        description:
          'Participa activamente en la solución de problemas de nivel nacional e internacional. Interactúa con otros participantes con tus mismos intereses.',
        icon: 'tabler:chalkboard',
      },
      {
        title: 'Los mejores instructores',
        description:
          'Aprende de astrofísicos con experiencia en investigación. Asesoría para estudios y aplicaciones a becas.',
        icon: 'tabler:school',
      },
      {
        title: 'Proyección mundial',
        description:
          'Podrás tener la oportunidad de clasificar a competencias internacionales y viajar a los países anfitriones.',
        icon: 'tabler:world-star',
      },
    ]}
  />

  <!-- Steps Widget ****************** -->

  <Steps
    title="Calendario 2025 - 2026"
    items={[
      {
        title: 'Agosto 2025',
        description:
          "Inicio de la IX Olimpiada Nacional de Astronomía 2026 (9NAO26) Pueden inscribirse todos los estudiantes que cumplan los requisitos de participación.",
        icon: 'tabler:number-1-small',
      },
      {
        title: 'Octubre 2025',
        description:
          "(9NAO26) Primer Examen Clasificatorio. Primer desafío de la Olimpiada Nacional 2026. Online a través de nuestra plataforma.",
        icon: 'tabler:number-2-small',
      },
      {
        title: 'Enero 2026',
        description:
          "Examen Nacional de Selección 2026. Participan los candidatos a la Delegación Ecuatoriana.",
        icon: 'tabler:number-3-small',
      },
      {
        title: 'Enero 2026',
        description:
          "(9NAO26) Segundo Examen Clasificatorio. Segundo desafío de la Olimpiada Nacional 2026. Online, durante una semana.",
        icon: 'tabler:number-3-small',
      },
      {
        title: 'Abril 2026',
        description:
          "(9NAO26) Examen Final de Selección. Último desafío de la Olimpiada Nacional 2026. Selección de Campeones Nacionales 2026.",
        icon: 'tabler:number-4-small',
      },
      {
        title: 'Octubre 2026',
        description:
          "19th International Olympiad on Astronomy and Astrophysics Vietnam 2026. Participan los 5 mejores estudiantes del Examen Nacional de Selección 2026.",
        icon: 'tabler:number-5-small',
      },
      {
        title: 'Noviembre 2026',
        description:
          "XVIII Olimpiada Latinoamericana de Astronomía y Astronáutica 2026. Participan los Campeones Nacionales 2026.",
        icon: 'tabler:number-6-small',
      },
    ]}
    image={{
      src: '~/assets/images/nebula-8753350_1920.jpg',
      alt: 'Nebula',
    }}
  />

  <!-- FAQs Widget ******************* -->

  <FAQs
    title="Preguntas frecuentes"
    subtitle="¡Respondemos las dudas más comúnes!"
    tagline="FAQs"
    classes={{ container: 'max-w-6xl' }}
    items={[
      {
        title: '¿Cuándo empieza la Olimpiada Nacional?',
        description:
          "Cada edición de la Olimpiada Nacional empieza en julio/agosto, informamos al público con un anuncio en redes sociales.",
      },
      {
        title: '¿Cuáles son los requisitos para participar?',
        description:
          'Debes tener menos de 18 años, ser estudiante de nivel secundario, ser ecuatoriano o extranjero residente.',
      },
    ]}
  />

  <!-- CallToAction Widget *********** -->

  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: 'Más información',
        href: 'https://astro-ec.github.io/services/',
        target: '_blank',
      },
    ]}
  >
    <Fragment slot="title">
      <br class="block sm:hidden" /><span class="sm:whitespace-nowrap">Únete al Comité Organizador</span>
    </Fragment>

    <Fragment slot="subtitle">
      ¿Te interesa apoyar a la siguiente generación de científicos del Ecuador?
      Participa organizando la Olimpiada Nacional de Astronomía
    </Fragment>
  </CallToAction>
</Layout>
